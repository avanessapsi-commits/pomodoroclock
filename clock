<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Widgets - Arquitetura Materna</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  
  html, body { height: 100%; }
  
  body {
    font-family: 'Inter', sans-serif;
    background: #4D1D2B;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 12px;
    transition: background 0.3s ease;
  }
  
  body.light-mode { background: #F5EFE7; }
  
  .container {
    background: #6B2E42;
    padding: clamp(16px, 4vw, 28px);
    width: 100%;
    max-width: 95vw;
    max-height: 95vh;
    transition: background 0.3s ease;
    position: relative;
    border-radius: 8px;
    overflow-y: auto;
  }
  
  body.light-mode .container {
    background: #FFFFFF;
    border: 1px solid #E8D4CA;
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: clamp(12px, 2vw, 20px);
    gap: 12px;
    flex-wrap: wrap;
  }

  .tabs {
    display: flex;
    gap: clamp(6px, 1.5vw, 12px);
  }

  .tab-btn {
    background: transparent;
    border: 1px solid #D4B5AB;
    color: #D4B5AB;
    padding: clamp(6px, 1.5vw, 8px) clamp(12px, 2vw, 16px);
    border-radius: 3px;
    cursor: pointer;
    font-size: clamp(8px, 1.5vw, 10px);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    font-family: 'Inter', sans-serif;
    transition: all 0.3s ease;
  }
  
  body.light-mode .tab-btn {
    border-color: #8B7A75;
    color: #8B7A75;
  }
  
  .tab-btn:hover {
    background: rgba(245, 230, 224, 0.1);
    border-color: #F5E6E0;
    color: #F5E6E0;
  }
  
  body.light-mode .tab-btn:hover {
    background: rgba(61, 38, 38, 0.1);
    border-color: #3D2626;
    color: #3D2626;
  }
  
  .tab-btn.active {
    background: rgba(245, 230, 224, 0.2);
    border-color: #F5E6E0;
    color: #F5E6E0;
  }
  
  body.light-mode .tab-btn.active {
    background: rgba(61, 38, 38, 0.1);
    border-color: #3D2626;
    color: #3D2626;
  }

  .theme-toggle {
    background: transparent;
    border: 1px solid #D4B5AB;
    color: #F5E6E0;
    padding: clamp(6px, 1.5vw, 8px) clamp(12px, 2vw, 16px);
    border-radius: 3px;
    cursor: pointer;
    font-size: clamp(8px, 1.5vw, 10px);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    font-family: 'Inter', sans-serif;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }
  
  body.light-mode .theme-toggle {
    border-color: #8B7A75;
    color: #3D2626;
  }
  
  .theme-toggle:hover {
    background: rgba(245, 230, 224, 0.1);
    border-color: #F5E6E0;
  }
  
  body.light-mode .theme-toggle:hover {
    background: rgba(61, 38, 38, 0.1);
    border-color: #3D2626;
  }

  .content { display: none; }
  .content.active { display: block; }

  .main-content {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 3vw, 28px);
    width: 100%;
    height: auto;
  }
  
  .clock {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(8px, 2vw, 12px);
    flex-shrink: 0;
    text-align: center;
  }
  
  .time-display {
    display: flex;
    gap: 0;
    align-items: baseline;
    justify-content: center;
  }
  
  .time-box {
    text-align: center;
    background: transparent;
  }
  
  .number {
    font-size: clamp(48px, 14vw, 72px);
    font-weight: 700;
    color: #F5E6E0;
    line-height: 0.95;
    letter-spacing: -3px;
    font-variant-numeric: tabular-nums;
  }
  
  body.light-mode .number { color: #4D1D2B; }
  
  .label {
    font-size: clamp(7px, 2vw, 9px);
    color: #D4B5AB;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    margin-top: 2px;
    font-weight: 600;
  }
  
  body.light-mode .label { color: #4D1D2B; }
  
  .separator {
    font-size: clamp(44px, 12vw, 60px);
    color: #D47A8C;
    font-weight: 700;
    line-height: 0.8;
    padding: 0 clamp(6px, 1.2vw, 10px);
    opacity: 0.5;
  }
  
  .periodo-label {
    font-size: clamp(8px, 2vw, 10px);
    color: #D4B5AB;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    font-weight: 600;
    margin-top: 2px;
  }
  
  body.light-mode .periodo-label { color: #4D1D2B; }
  
  .info {
    display: flex;
    gap: clamp(16px, 3vw, 24px);
    text-align: center;
    justify-content: center;
    flex-wrap: wrap;
  }
  
  .info-item {
    padding: 0;
    background: transparent;
    flex: 0 1 auto;
    min-width: fit-content;
  }
  
  .info-label {
    font-size: clamp(7px, 2vw, 9px);
    color: #D4B5AB;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 4px;
    font-weight: 600;
  }
  
  body.light-mode .info-label { color: #4D1D2B; }
  
  .info-value {
    font-size: clamp(11px, 2.5vw, 14px);
    color: #F5E6E0;
    font-weight: 600;
    line-height: 1.3;
  }
  
  body.light-mode .info-value { color: #4D1D2B; }
  
  .condition-text {
    font-size: clamp(10px, 2vw, 12px);
    color: #E8D4CA;
  }
  
  body.light-mode .condition-text { color: #4D1D2B; }

  .timer-display { text-align: center; margin-bottom: clamp(12px, 2vw, 16px); }
  
  .timer-number {
    font-size: clamp(40px, 12vw, 56px);
    font-weight: 700;
    color: #F5E6E0;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    letter-spacing: -2px;
  }
  
  body.light-mode .timer-number { color: #4D1D2B; }
  
  .status-line {
    font-size: clamp(8px, 2vw, 10px);
    color: #D4B5AB;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    font-weight: 700;
    margin-top: clamp(4px, 1vw, 6px);
  }
  
  body.light-mode .status-line { color: #4D1D2B; }
  
  .controls {
    display: flex;
    gap: clamp(6px, 1.5vw, 10px);
    justify-content: center;
    margin: clamp(12px, 2vw, 16px) 0;
    flex-wrap: wrap;
  }
  
  button {
    background: transparent;
    border: 1px solid #D4B5AB;
    color: #F5E6E0;
    padding: clamp(6px, 1.5vw, 8px) clamp(10px, 2vw, 16px);
    border-radius: 3px;
    cursor: pointer;
    font-size: clamp(8px, 1.5vw, 10px);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    font-family: 'Inter', sans-serif;
    transition: all 0.3s ease;
  }
  
  body.light-mode button {
    border-color: #8B7A75;
    color: #4D1D2B;
  }
  
  button:hover {
    background: rgba(245, 230, 224, 0.1);
    border-color: #F5E6E0;
    color: #F5E6E0;
  }
  
  body.light-mode button:hover {
    background: rgba(61, 38, 38, 0.1);
    border-color: #4D1D2B;
    color: #4D1D2B;
  }
  
  button:active { transform: scale(0.95); }
  
  .info-row {
    display: flex;
    gap: clamp(15px, 3vw, 24px);
    justify-content: center;
    margin: clamp(10px, 2vw, 14px) 0;
    flex-wrap: wrap;
  }
  
  .settings {
    display: flex;
    gap: clamp(4px, 1vw, 8px);
    justify-content: center;
    margin-top: clamp(10px, 2vw, 14px);
    padding-top: clamp(10px, 2vw, 14px);
    border-top: 1px solid rgba(245, 230, 224, 0.1);
    flex-wrap: wrap;
  }
  
  body.light-mode .settings { border-top: 1px solid rgba(61, 38, 38, 0.1); }
  
  .time-preset {
    background: transparent;
    border: 1px solid #D4B5AB;
    color: #D4B5AB;
    padding: clamp(3px, 0.8vw, 5px) clamp(6px, 1.5vw, 10px);
    border-radius: 2px;
    cursor: pointer;
    font-size: clamp(7px, 1.5vw, 9px);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    font-family: 'Inter', sans-serif;
    transition: all 0.3s ease;
  }
  
  .time-preset:hover {
    background: rgba(212, 181, 171, 0.1);
    border-color: #F5E6E0;
    color: #F5E6E0;
  }
  
  .time-preset.active {
    background: rgba(245, 230, 224, 0.2);
    border-color: #F5E6E0;
    color: #F5E6E0;
  }
  
  body.light-mode .time-preset {
    border-color: #8B7A75;
    color: #4D1D2B;
  }
  
  body.light-mode .time-preset:hover {
    background: rgba(61, 38, 38, 0.1);
    border-color: #4D1D2B;
    color: #4D1D2B;
  }
  
  body.light-mode .time-preset.active {
    background: rgba(61, 38, 38, 0.1);
    border-color: #4D1D2B;
    color: #4D1D2B;
  }

  .status-sync {
    font-size: clamp(7px, 1.5vw, 8px);
    color: #E8D4CA;
    text-align: center;
    margin-top: clamp(8px, 1.5vw, 10px);
  }
  
  body.light-mode .status-sync { color: #4D1D2B; }

  @media (min-aspect-ratio: 1.2/1) {
    .main-content { flex-direction: row; gap: clamp(20px, 4vw, 40px); }
    .clock { flex-direction: column; }
    .info { flex-direction: row; }
  }

  @media (max-aspect-ratio: 1.2/1) {
    .main-content { flex-direction: column; gap: 20px; }
    .clock { flex-direction: column; }
    .info { flex-direction: row; gap: 16px; }
  }

  @media (max-width: 500px) {
    .container { padding: 12px; }
    .number { font-size: 40px; }
    .separator { font-size: 36px; }
    .header { flex-direction: column; }
    .tabs { width: 100%; justify-content: center; }
  }
</style>
</head>
<body>

<div class="container">
  <div class="header">
    <div class="tabs">
      <button class="tab-btn active" data-tab="clock">⏰ Relógio</button>
      <button class="tab-btn" data-tab="pomodoro">🍅 Pomodoro</button>
    </div>
    <button class="theme-toggle" id="themeToggle">🌙 Escuro</button>
  </div>

  <div id="clock" class="content active">
    <div class="main-content">
      <div class="clock">
        <div class="time-display">
          <div class="time-box">
            <div class="number" id="horas">00</div>
          </div>
          <div class="separator">:</div>
          <div class="time-box">
            <div class="number" id="minutos">00</div>
          </div>
        </div>
        <div class="periodo-label" id="periodo">AM</div>
      </div>
      
      <div class="info">
        <div class="info-item">
          <div class="info-label">Data</div>
          <div class="info-value" id="data">--</div>
        </div>
        <div class="info-item">
          <div class="info-label">Temp</div>
          <div class="info-value" id="temperatura">--°</div>
        </div>
        <div class="info-item">
          <div class="info-label">Condição</div>
          <div class="condition-text" id="condicao">--</div>
        </div>
      </div>
    </div>
  </div>

  <div id="pomodoro" class="content">
    <div class="timer-display">
      <div class="timer-number" id="timerDisplay">25:00</div>
      <div class="status-line" id="statusText">PAUSADO - TRABALHO</div>
    </div>
    
    <div class="controls">
      <button id="startBtn">Iniciar</button>
      <button id="pauseBtn">Pausar</button>
      <button id="resetBtn">Reset</button>
    </div>
    
    <div class="info-row">
      <div class="info-item">
        <div class="info-label">Ciclos</div>
        <div class="info-value" id="cycles">0</div>
      </div>
      <div class="info-item">
        <div class="info-label">Tempo Total</div>
        <div class="info-value" id="totalTime">0m</div>
      </div>
    </div>
    
    <div class="settings">
      <button class="time-preset active" data-work="25">25</button>
      <button class="time-preset" data-work="20">20</button>
      <button class="time-preset" data-work="15">15</button>
      <button class="time-preset" data-work="10">10</button>
      <button class="time-preset" data-work="5">5</button>
    </div>

    <div class="status-sync" id="syncStatus">✓ Pomodoro ativo</div>
  </div>
</div>

<script>
const NOTION_API_KEY = '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';
const NOTION_DATABASE_ID = '0483ff059e7440f48dbb232973118b28';

const themeToggle = document.getElementById('themeToggle');
const body = document.body;
const savedTheme = localStorage.getItem('widgetsTheme') || 'dark';
if (savedTheme === 'light') {
  body.classList.add('light-mode');
  themeToggle.textContent = '☀️ Claro';
}
themeToggle.addEventListener('click', () => {
  body.classList.toggle('light-mode');
  const isLight = body.classList.contains('light-mode');
  localStorage.setItem('widgetsTheme', isLight ? 'light' : 'dark');
  themeToggle.textContent = isLight ? '☀️ Claro' : '🌙 Escuro';
});

const tabBtns = document.querySelectorAll('.tab-btn');
const contents = document.querySelectorAll('.content');
tabBtns.forEach(btn => {
  btn.addEventListener('click', () => {
    tabBtns.forEach(b => b.classList.remove('active'));
    contents.forEach(c => c.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById(btn.dataset.tab).classList.add('active');
  });
});

function atualizaHora() {
  const agora = new Date();
  document.getElementById('horas').textContent = String(agora.getHours()).padStart(2, '0');
  document.getElementById('minutos').textContent = String(agora.getMinutes()).padStart(2, '0');
  document.getElementById('periodo').textContent = agora.getHours() >= 12 ? 'PM' : 'AM';
}

function atualizaData() {
  const agora = new Date();
  const meses = ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'];
  const dias = ['dom', 'seg', 'ter', 'qua', 'qui', 'sex', 'sab'];
  document.getElementById('data').textContent = `${dias[agora.getDay()]}, ${agora.getDate()} ${meses[agora.getMonth()]}`;
}

function buscaClima() {
  fetch('https://api.open-meteo.com/v1/forecast?latitude=-23.5606&longitude=-46.7647&current=temperature_2m,weather_code&temperature_unit=celsius')
    .then(r => r.json())
    .then(dados => {
      if (dados.current) {
        document.getElementById('temperatura').textContent = Math.round(dados.current.temperature_2m) + '°';
        const condicoes = {0:'Ensolarado', 1:'P. nublado', 2:'Nublado', 3:'Encoberto', 45:'Nebuloso', 48:'Nebuloso', 51:'Chuvisco', 61:'Chuva', 63:'Chuva mod.', 65:'Chuva forte', 71:'Neve', 80:'Pancadas', 95:'Trovoada'};
        document.getElementById('condicao').textContent = condicoes[dados.current.weather_code] || '--';
      }
    })
    .catch(() => { document.getElementById('condicao').textContent = '--'; });
}

atualizaHora();
atualizaData();
buscaClima();
setInterval(atualizaHora, 1000);
setInterval(atualizaData, 60000);
setInterval(buscaClima, 600000);

let workDuration = 25 * 60;
let breakDuration = 5 * 60;
let timeLeft = workDuration;
let isRunning = false;
let isWorkPhase = true;
let completedCycles = 0;
let totalTimeSpent = 0;
let timerInterval = null;

const startBtn = document.getElementById('startBtn');
const pauseBtn = document.getElementById('pauseBtn');
const resetBtn = document.getElementById('resetBtn');
const timerDisplay = document.getElementById('timerDisplay');
const statusText = document.getElementById('statusText');
const cyclesDisplay = document.getElementById('cycles');
const totalTimeDisplay = document.getElementById('totalTime');
const presets = document.querySelectorAll('.time-preset');
const syncStatus = document.getElementById('syncStatus');

function updateDisplay() {
  const minutes = Math.floor(timeLeft / 60);
  const seconds = timeLeft % 60;
  timerDisplay.textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
  const phase = isWorkPhase ? 'TRABALHO' : 'PAUSA';
  const state = isRunning ? 'RODANDO' : 'PAUSADO';
  statusText.textContent = `${state} - ${phase}`;
}

function playNotification() {
  try {
    const audioContext = new (window.AudioContext || window.webkitAudioContext)();
    const oscillator = audioContext.createOscillator();
    const gain = audioContext.createGain();
    oscillator.connect(gain);
    gain.connect(audioContext.destination);
    oscillator.frequency.value = isWorkPhase ? 800 : 600;
    oscillator.type = 'sine';
    gain.gain.setValueAtTime(0.3, audioContext.currentTime);
    gain.gain.exponentialRampToValueAtTime(0.01, audioContext.currentTime + 0.5);
    oscillator.start(audioContext.currentTime);
    oscillator.stop(audioContext.currentTime + 0.5);
  } catch (e) {}
}

async function saveToNotion(type) {
  const data = {
    parent: { database_id: NOTION_DATABASE_ID },
    properties: {
      title: { title: [{ text: { content: `Pomodoro - ${type}` } }] },
      Tipo: { select: { name: type === 'work' ? 'Trabalho' : 'Pausa' } },
      Hora: { date: { start: new Date().toISOString() } },
      Duração: { number: type === 'work' ? workDuration / 60 : breakDuration / 60 },
      Status: { select: { name: 'Concluído' } }
    }
  };

  try {
    const response = await fetch('https://api.notion.com/v1/pages', {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${NOTION_API_KEY}`,
        'Content-Type': 'application/json',
        'Notion-Version': '2022-06-28'
      },
      body: JSON.stringify(data)
    });
    if (response.ok) {
      syncStatus.textContent = '✓ Sincronizado';
      setTimeout(() => { syncStatus.textContent = '✓ Pomodoro ativo'; }, 2000);
    }
  } catch (error) {}
}

function startTimer() {
  if (isRunning) return;
  isRunning = true;
  timerInterval = setInterval(() => {
    timeLeft--;
    totalTimeSpent++;
    updateDisplay();
    const hours = Math.floor(totalTimeSpent / 3600);
    const minutes = Math.floor((totalTimeSpent % 3600) / 60);
    totalTimeDisplay.textContent = hours > 0 ? `${hours}h ${minutes}m` : `${minutes}m`;
    if (timeLeft <= 0) {
      playNotification();
      saveToNotion(isWorkPhase ? 'work' : 'break');
      if (isWorkPhase) {
        completedCycles++;
        cyclesDisplay.textContent = completedCycles;
        isWorkPhase = false;
        timeLeft = breakDuration;
      } else {
        isWorkPhase = true;
        timeLeft = workDuration;
      }
      updateDisplay();
    }
  }, 1000);
}

function pauseTimer() {
  isRunning = false;
  clearInterval(timerInterval);
  updateDisplay();
}

function resetTimer() {
  isRunning = false;
  clearInterval(timerInterval);
  isWorkPhase = true;
  timeLeft = workDuration;
  updateDisplay();
}

presets.forEach(preset => {
  preset.addEventListener('click', () => {
    if (isRunning) return;
    presets.forEach(p => p.classList.remove('active'));
    preset.classList.add('active');
    const newDuration = parseInt(preset.dataset.work) * 60;
    workDuration = newDuration;
    timeLeft = newDuration;
    isWorkPhase = true;
    updateDisplay();
  });
});

startBtn.addEventListener('click', startTimer);
pauseBtn.addEventListener('click', pauseTimer);
resetBtn.addEventListener('click', resetTimer);

updateDisplay();
</script>

</body>
</html>
